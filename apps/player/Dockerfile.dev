FROM node:20-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# Set the working directory inside the container.
WORKDIR /usr/src/app

# --- Dependency Caching Optimization ---
# Copy all root-level dependency manifests first.
# This layer is cached by Docker and only re-runs if these files change.
COPY ./package.json ./pnpm-lock.yaml ./pnpm-workspace.yaml ./

# Copy the app-specific package.json.
COPY ./apps/player/package.json ./apps/player/

# Install ONLY the dependencies required for the 'player' workspace.
# This is much faster than installing dependencies for the entire monorepo.
RUN pnpm install --filter player

# Expose the default port used by the Vite dev server.
EXPOSE 5173

# Define the command to start the Vite dev server.
# The '--host' flag is crucial to make the server accessible from outside the container.
CMD ["pnpm", "--filter", "player", "dev", "--host"]