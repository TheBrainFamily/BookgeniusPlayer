    "build-only": "vite build",
    "build-for-docker": "vite build && pnpm process-all-books-docker",
    "build-for-docker-front": "vite build",
    "post-build": "bun run ../../tools/scripts/prepare-docker-build.ts",
    "dev": "vite dev",
    "prepare": "husky",
    "deploy": "VITE_BOOK=Pharaon npx vite build && rsync -av ./dist root@64.23.230.45:/var/www/faraon/",
    "deploy:1984": "VITE_BOOK=1984 npx vite build && rsync -av ./dist root@64.23.230.45:/var/www/1984/",
    "deploy:1984-english": "VITE_LANG=EN VITE_BOOK=1984-English npx vite build && rsync -av ./dist root@64.23.230.45:/var/www/1984-english/",
    "deploy:alice": "VITE_LANG=EN VITE_BOOK='Alice-Wonderland' VITE_BOOK_NAME='Alice-Wonderland' VITE_BOOK_PATH='public_books/Alice-Wonderland/' VITE_BOOK_DIR='public_books/Alice-Wonderland' npx vite build && rsync -av ./dist/ root@64.23.230.45:/var/www/alice",
    "deploy:romeo-juliet": "VITE_LANG=EN VITE_BOOK='Romeo-And-Juliet' VITE_BOOK_NAME='Romeo-And-Juliet' VITE_BOOK_PATH='public_books/Romeo-And-Juliet/' VITE_BOOK_DIR='public_books/Romeo-And-Juliet' npx vite build && rsync -av ./dist/ root@64.23.230.45:/var/www/romeoandjuliet",
    "deploy:fatherland": "VITE_LANG=EN VITE_BOOK='fatherland' VITE_BOOK_NAME='fatherland' VITE_BOOK_PATH='public_books/fatherland/' VITE_BOOK_DIR='public_books/fatherland' npx vite build && rsync -av ./dist/ root@64.23.230.45:/var/www/fatherland-danielo",
    "deploy:conrad": "VITE_BOOK=Conrad-Tajny-Agent npx vite build && rsync -av ./dist root@64.23.230.45:/var/www/tajny-agent/",
    "test": "jest",
    "typecheck": "tsc --noEmit --incremental",
    "typecheck:ci": "tsc --noEmit --incremental --pretty false",
    "lint": "eslint --cache --fix src/",
    "lint:ci": "eslint --cache src/",
    "prettier:check": "prettier --check src/ --quiet 2>&1 | grep -v 'Ignored unknown option'",
    "analyze-characters": "tsx ./scripts/analyze-character-mentions.ts",
    "check-assets": "tsx ./scripts/check-character-assets.ts",
    "compile-book-data": "node ./scripts/compileBookData.js"
