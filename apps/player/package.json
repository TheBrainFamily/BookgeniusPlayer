{
  "name": "@bookgenius/player",
  "version": "1.0.0",
  "description": "BookGenius interactive audiobook player - embeddable React component",
  "keywords": [
    "audiobook",
    "player",
    "react",
    "interactive"
  ],
  "license": "UNLICENSED",
  "author": "BookGenius",
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-lib/index.js",
      "types": "./dist-lib/index.d.ts"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "files": [
    "dist-lib",
    "tailwind-preset.js"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "convex": "^1.0.0",
    "motion": "^12.0.0",
    "zustand": "^4.0.0 || ^5.0.0",
    "i18next": "^23.0.0 || ^24.0.0 || ^25.0.0",
    "react-i18next": "^13.0.0 || ^14.0.0 || ^15.0.0",
    "lucide-react": "^0.400.0"
  },
  "scripts": {
    "analyze-characters": "tsx ./scripts/analyze-character-mentions.ts",
    "build": "node scripts/setEnv.js --env docker vite build",
    "build:lib": "vite build --config vite.config.lib.mts",
    "build-only": "node scripts/setEnv.js --env development vite build",
    "check-assets": "tsx ./scripts/check-character-assets.ts",
    "compile-book-data": "node ../books-generator/src/compileBookData.js",
    "dev": "pnpm start",
    "generate-book": "tsx ../books-generator/src/generateBook.ts",
    "lint": "eslint --cache --fix src/",
    "lint:ci": "eslint --cache --quiet src/",
    "post-build": "bun run ../../tools/scripts/prepare-docker-build.ts",
    "prettier:check": "prettier --check src/ --quiet 2>&1 | grep -v 'Ignored unknown option'",
    "process-all-books": "tsx ../books-generator/src/processAllBooks.ts",
    "process-book": "tsx ../books-generator/src/processBook.ts",
    "start": "tsx ./scripts/startDev.ts",
    "test": "jest",
    "typecheck": "tsgo --noEmit --incremental",
    "typecheck:ci": "tsgo --noEmit --incremental --pretty false"
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.1",
    "@capawesome/capacitor-asset-manager": "^7.0.0",
    "@journeyapps/domparser": "^0.4.1",
    "@openai/agents-realtime": "^0.1.6",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.6",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codec-parser": "^2.5.0",
    "cors": "^2.8.5",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-resources-to-backend": "^1.2.1",
    "inquirer": "^12.6.1",
    "jsdom": "^26.1.0",
    "lodash": "^4.17.21",
    "lodash.debounce": "^4.0.8",
    "music-metadata": "^11.2.2",
    "nanoid": "^5.1.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "use-local-storage-state": "^19.5.0",
    "xml2js": "^0.6.2",
    "xmldom": "^0.6.0",
    "zod": "^3.25.40"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "convex": "^1.21.1",
    "i18next": "^25.2.1",
    "lucide-react": "^0.479.0",
    "motion": "^12.10.5",
    "react-i18next": "^15.5.2",
    "zustand": "^5.0.5",
    "@convex-dev/auth": "^0.0.90",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.21.0",
    "@jest/globals": "^29.7.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/axios": "^0.9.36",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^9.0.8",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/lodash-es": "^4.17.12",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.9",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^10.0.0",
    "@types/yargs": "^17.0.33",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@xmldom/xmldom": "^0.9.8",
    "autoprefixer": "^10.4.21",
    "copyfiles": "^2.4.1",
    "dependency-cruiser": "^16.10.2",
    "diacritics": "^1.3.0",
    "esbuild-jest-transform": "^2.0.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.3.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-static-copy": "^2.3.1",
    "workbox-core": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-range-requests": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "workbox-window": "^7.3.0"
  }
}
