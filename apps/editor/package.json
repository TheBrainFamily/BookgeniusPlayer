{
  "name": "editor",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit --incremental",
    "typecheck:ci": "tsc --noEmit --incremental --pretty false",
    "prettier:check": "prettier --check src/ --quiet 2>&1 | grep -v 'Ignored unknown option'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "diff": "^8.0.2",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-diff-view": "^3.3.2",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
