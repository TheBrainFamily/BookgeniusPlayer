# Server Configuration
PORT=3000
NODE_ENV=production

# API Keys (replace with your actual keys)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GEMINI_API_KEY=your_gemini_api_key

# Database Configuration (if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/book-viewer

# Cloudflare R2 Configuration (for embedding storage)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_bucket_name

# Admin secret for cache invalidation endpoint
ADMIN_SECRET=your_admin_secret

# Prefetch mode: load all books on startup, disable TTL eviction
PREFETCH_ALL_BOOKS=false

# RAM budget for embedding cache in MB (default: 1500)
# Set based on your server's available RAM
EMBEDDING_RAM_BUDGET_MB=1500

# Logging
LOG_LEVEL=info