    "cleanup-books-assets": "bun ./tools/scripts/cleanup-books-assets.ts",
    "lint": "bun --filter '*' lint",
    "lint:ci": "bun --filter '*' lint:ci",
    "typecheck": "bun --filter '*' typecheck",
    "typecheck:ci": "bun --filter '*' typecheck:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@convex-dev/auth": "^0.0.90",
    "@eslint/js": "^9.33.0",
    "@types/bun": "^1.3.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "convex": "^1.31.2",
    "convex-test": "^0.0.41",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "ink": "^6.1.0",
    "lint-staged": "^16.1.4",
    "npm-run-all": "^4.1.5",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "typescript": "5.8.2",
