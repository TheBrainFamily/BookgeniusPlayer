{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "dev:player": "pnpm --filter player dev",
    "dev:core-api": "pnpm --filter core-api dev",
    "dev:editor": "pnpm --filter editor dev",
    "build:player:docker": "pnpm --filter player build-for-docker",
    "build:player:front": "pnpm --filter player build-for-docker-front",
    "build:platform": "pnpm --filter platform build",
    "prepare:docker": "bun run ./tools/scripts/prepare-docker-build.ts",
    "build:front-parallel": "run-p build:player:front build:platform",
    "build:docker:with-books": "run-s build:player:docker build:platform prepare:docker",
    "build:docker:front-only": "run-s build:front-parallel prepare:docker"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "husky": "^9.1.7",
    "ink": "^6.1.0",
    "lint-staged": "^16.0.0",
    "npm-run-all": "^4.1.5",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1"
  }
}
