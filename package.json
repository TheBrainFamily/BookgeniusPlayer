{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky && git config blame.ignoreRevsFile .git-blame-ignore-revs",
    "dev:player": "bun --filter player dev",
    "dev:editor": "bun --filter editor dev",
    "build:player:docker": "bun --filter player build-for-docker",
    "build:player:front": "bun --filter player build-for-docker-front",
    "build:platform": "bun --filter platform build",
    "build:wukong": "bun --filter wukong build",
    "prepare:docker": "bun ./tools/scripts/prepare-docker-build.ts",
    "build:front-parallel": "bun --filter player --filter platform build",
    "prettier:check": "bun --filter '*' prettier:check",
    "process-all-books": "bun --filter player process-all-books",
    "update-prod-versions": "bun ./tools/scripts/update-prod-versions.ts",
    "cleanup-books-assets": "bun ./tools/scripts/cleanup-books-assets.ts",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:ci": "eslint . --cache --quiet",
    "typecheck": "FORCE_COLOR=1 turbo run typecheck -- --pretty | bun ./tools/scripts/typecheck.ts",
    "typecheck:ci": "turbo run typecheck -- --pretty",
    "typecheck:watch": "bun run tools/ts-watch-server/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "bun@1.3.5",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@convex-dev/eslint-plugin": "^1.1.1",
    "@eslint/js": "^9.33.0",
    "@types/bun": "^1.3.5",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jsdom": "^27.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260104.1",
    "@vitest/runner": "^4.0.16",
    "@vitest/snapshot": "^4.0.16",
    "convex": "^1.31.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "turbo": "^2.7.3",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.39.1",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "typescript": "5.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --cache --fix"
    ],
    "*.{js,jsx,ts,tsx,json,md,yml,mjs,cjs}": [
      "prettier --write"
    ]
  },
  "dependencies": {},
  "workspaces": [
    "apps/*",
    "convex"
  ]
}
