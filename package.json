{
  "name": "monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "dev:player": "pnpm --filter player dev",
    "dev:core-api": "pnpm --filter core-api dev",
    "dev:editor": "pnpm --filter editor dev",
    "build:player:docker": "pnpm --filter player build-for-docker",
    "build:player:front": "pnpm --filter player build-for-docker-front",
    "build:platform": "pnpm --filter platform build",
    "prepare:docker": "bun run ./tools/scripts/prepare-docker-build.ts",
    "build:front-parallel": "run-p build:player:front build:platform",
    "build:docker:with-books": "run-s build:player:docker build:platform",
    "build:docker:front-only": "run-s build:front-parallel prepare:docker",
    "prepare:gateway": "zip -r gateway.zip ./docker-compose.gateway.yml ./apps/gateway/configs ./deployment/templates",
    "prettier:check": "pnpm pnpm -r --if-present prettier:check",
    "process-all-books-docker": "pnpm --filter player process-all-books-docker",
    "update-prod-versions": "bun run ./tools/scripts/update-prod-versions.ts",
    "cleanup-books-assets": "bun run ./tools/scripts/cleanup-books-assets.ts",
    "lint": "pnpm pnpm -r --if-present lint",
    "lint:ci": "pnpm pnpm -r --if-present lint:ci",
    "typecheck": "pnpm pnpm -r --if-present typecheck",
    "typecheck:ci": "pnpm pnpm -r --if-present typecheck:ci"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "ink": "^6.1.0",
    "lint-staged": "^16.1.4",
    "npm-run-all": "^4.1.5",
    "p-queue": "^8.1.0",
    "p-retry": "^6.2.1",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.39.1"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.8.2",
      "react": "19.1.1",
      "react-dom": "19.1.1",
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.7"
    }
  },
  "lint-staged": {
    "apps/**/*.{js,jsx,ts,tsx,json,md,yml}": [
      "pnpm prettier --write"
    ]
  }
}
